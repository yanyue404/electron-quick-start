{
  "name": "electron-quick-start",
  "version": "1.0.0",
  "description": "A multi-page Electron application with Vite and Vue 3",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:exe": "vite build && electron-builder",
    "build:exe:dir": "vite build && electron-builder --dir",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.electron.quick-start",
    "productName": "Electron Quick Start",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Electron Quick Start"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    }
  },
  "repository": "https://github.com/electron/electron-quick-start",
  "keywords": [
    "Electron",
    "Vite",
    "Vue3",
    "TodoMVC",
    "multi-page"
  ],
  "author": "GitHub",
  "license": "CC0-1.0",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "dependencies": {
    "vue": "^3.4.0"
  }
}
